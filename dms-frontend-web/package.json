{
  "name": "dms-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run lint",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "project": "cd .. && mvn clean install && docker-compose up -d",
    "localproject": "cd .. && mvn clean install && docker-compose up -d && ng serve",
    "format": "npx prettier --write \"src/**/*.{ts,html,css,json}\"",
    "check-format": "npx prettier --check \"src/**/*.{ts,html,css,json}\"",
    "prepare": "cd .. && husky dms-frontend-web/.husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.11",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "19.2.11",
    "@angular/compiler": "19.2.11",
    "@angular/core": "19.2.11",
    "@angular/forms": "19.2.11",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "19.2.11",
    "@angular/platform-browser-dynamic": "19.2.11",
    "@angular/router": "19.2.11",
    "@designsystem-se/af": "^32.0.1",
    "@designsystem-se/af-angular": "^32.1.1",
    "@kolkov/angular-editor": "^2.1.0",
    "@tailwindcss/cli": "^4.1.11",
    "ag-charts-community": "^13.0.0",
    "lucide-angular": "^0.536.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.11",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "19.2.11",
    "@angular/localize": "19.2.11",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/jasmine": "~5.1.8",
    "angular-eslint": "20.3.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.5.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.7.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.32.1"
  }
}
